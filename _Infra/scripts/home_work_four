	insert into temperature_correction (t0_from, t0_to, delta_tv) values
		(null, 0, 0), (0, 5, 0.5), (10, 15, 1), (20, 20, 1.5),
		(25, 25, 2), (30, 30, 3.5), (40, 40, 4.5);
	commit;
end $$;

-- связи и ограничения 
do $$
begin
	-- ключи и уникальность
	alter table positions add primary key (id);
	alter table positions alter column name set not null;
	alter table positions add constraint uq_positions_name unique (name);

	alter table eq_types add primary key (id);
	alter table eq_types add constraint uq_eq_types_name unique (name);

	alter table users add primary key (id);
	alter table users alter column full_name set not null;
	alter table users add foreign key (position_id) references positions (id);

	alter table packs add primary key (id);
	alter table packs alter column created_on set not null;
	alter table packs add foreign key (user_id) references users (id);
	alter table packs add foreign key (eq_type_id) references eq_types (id);

	alter table base_units add primary key (id);

	alter table units add primary key (id);
	alter table units add constraint uq_units_short_name unique (short_name);
	alter table units add foreign key (base_unit_id) references base_units (id);

	alter table parameter_types add primary key (id);
	alter table parameter_types add constraint uq_parameter_types_name unique (name);
	alter table parameter_types add foreign key (unit_id) references units (id);

	alter table parametrs add primary key (id);
	alter table parametrs alter column value set not null;
	alter table parametrs add foreign key (pack_id) references packs (id);
	alter table parametrs add foreign key (parameter_type_id) references parameter_types (id);

	alter table temperature_correction add primary key (id);
	alter table temperature_correction alter column delta_tv set not null;
	commit;
end $$;
