		(3, 'миллиметр ртутного столба', 'мм рт. ст.'),
		(4, 'большое деление угломера', 'б. д. у.'), (5, 'метр в секунду', 'м/с');
	insert into parameter_types (unit_id, name) values
		(1, 'высота метеопоста'), (2, 'температура воздуха на высоте метеопоста'),
		(3, 'давление атмосферы на высоте метеопоста'),
		(4, 'направление ветра в приземном слое воздуха'),
		(5, 'скорость ветра в приземном слое воздуха'), (1, 'дальность сноса пуль');
	insert into parametrs (pack_id, parameter_type_id, value) values
		(1, 1, 100), (1, 2, 15), (1, 3, 750), (1, 4, 0), (1, 5, 0),
