--структура таблиц + счётчики
do $$
begin
	-- справочник должностей
	create table positions(
		id integer not null,
		name varchar(150) not null
	);
	-- справочник оборудования
	create table eq_types(
		id integer not null,
		name varchar(150) not null
	);
	-- сотрудники (ссылка на должность)
	create table users(
		id integer not null,
		full_name varchar(150) not null,
		position_id integer not null
	);
	-- пачки измерений (ссылки на сотрудника и оборудование)
	create table packs(
		id integer not null,
		user_id integer not null,
		eq_type_id integer not null,
		created_on date not null
	);
	-- измерения (ссылки на пачку и параметр)
	create table parametrs(
		id integer not null,
		pack_id integer not null,
		parameter_type_id integer not null,
		value numeric(8,2) not null
	);
	-- справочник величин
	create table base_units(
		id integer not null,
		name varchar(100) not null
	);
	-- справочник единиц (ссылка на величину)
	create table units(
		id integer not null,
		base_unit_id integer not null,
		name varchar(100) not null,
		short_name varchar(20) not null
	);
	-- справочник параметров (ссылка на единицу)
	create table parameter_types(
		id integer not null,
		unit_id integer not null,
		name varchar(150) not null
	);
	-- расчёт температуры 
	create table temperature_correction(
		id integer not null,
		t0_from numeric,
		t0_to numeric,
		delta_tv numeric not null
	);

	-- счётчики: id подставляется сам
	create sequence seq_positions;
	alter table positions alter column id set default nextval('seq_positions');
	create sequence seq_eq_types;
	alter table eq_types alter column id set default nextval('seq_eq_types');
	create sequence seq_users;
	alter table users alter column id set default nextval('seq_users');
	create sequence seq_packs;
	alter table packs alter column id set default nextval('seq_packs');
	create sequence seq_parametrs;
	alter table parametrs alter column id set default nextval('seq_parametrs');
	create sequence seq_base_units;
	alter table base_units alter column id set default nextval('seq_base_units');
	create sequence seq_units;
	alter table units alter column id set default nextval('seq_units');
	create sequence seq_parameter_types;
	alter table parameter_types alter column id set default nextval('seq_parameter_types');
	create sequence seq_temperature_correction;
	alter table temperature_correction alter column id set default nextval('seq_temperature_correction');
	commit;
end $$;

--тестовые данные 
do $$
begin
	insert into positions (name) values
		('оператор метеопоста'), ('начальник метепоста'), ('техник');
	insert into eq_types (name) values ('ДМК'), ('ВР');
	insert into users (full_name, position_id) values
		('Иванов Иван', 1), ('Петров Пётр', 2);
	insert into packs (user_id, eq_type_id, created_on) values
		(1, 1, date '2026-09-01'), (2, 2, date '2026-09-02');
	insert into base_units (name) values
		('длина'), ('температура'), ('давление'), ('плоский угол'), ('скорость');
	insert into units (base_unit_id, name, short_name) values
