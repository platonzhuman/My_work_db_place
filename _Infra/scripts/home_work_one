-- 1. create auto delete bd
drop table if exists parametrs;
drop table if exists packs;
drop table if exists users;
drop table if exists eq_types;
drop table if exists positions;


-- 2. create bd and true connect 
CREATE TABLE positions(
id integer not null,
name varchar(150) not null,
constraint pc_positions primary key (id),
constraint uq_positions_name unique (name)
);

CREATE TABLE eq_types(
id  integer not null,
name varchar(150) not null,
constraint pc_eq_types primary key (id),
constraint uq_eq_types_name unique (name)
);

CREATE TABLE users(
id integer not null,
full_name varchar(150) not null,
position_id integer not null,
constraint pc_users primary key (id)
);

CREATE TABLE packs(
id integer not null,
user_id integer not null,
eq_type_id integer not null,
created_on date not null,
constraint pc_packs primary key (id)
);

CREATE TABLE parametrs(
id integer not null,
pack_id integer not null,
name varchar(100) not null,
unit varchar(20),
value numeric(10,2) not null,
constraint pc_parametrs primary key (id)
);

-- 3. input basic data 

insert into eq_types (id, name) values
    (1, 'ДМК'),
    (2, 'ВР');

insert into positions (id, name) values
    (1, 'оператор метепоста'),
    (2, 'начальник метепоста'),
    (3, 'техник');

